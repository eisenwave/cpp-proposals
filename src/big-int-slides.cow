\slide{
\slideh{Design philosophy}

\ol(style="font-size: 125%"){
  \li{\tcode{big_int} should be easy to use and feel like \tcode{int}.}
  \li{\tcode{big_int} should be viable for almost all applications.}
  \li{\tcode{big_int} should allow the user to provide additional operations without overhead.}
  \li{\tcode{big_int} should have \u{value-preserving} conversions.}
  \li{\tcode{big_int} should be \tcode{constexpr}.}
}
}

\slide{
\slideh{Interface}

\cppblock{
// in header <big_int>
namespace std {
  using uint_multiprecision_t = \exposid{implementation-defined};

  template<size_t min_inplace_capacity, /* in bits */
           class Limb  = uint_multiprecision_t,
           class Alloc = allocator<uint_multiprecision_t>>
    class basic_big_int;

  using big_int = basic_big_int<\exposid{implementation-defined}>;

  inline namespace literals { /* for 123n ... */ }
}
}
}

\slide{
\slideh{Mental model}

\ul{
  \li{\tcode{big_int} is a \q{\tt{small_vector}} with numeric operators}
  \li{representation uses sign and magnitude, small object optimization}
}

\div(style="font-size: 90%"){
\cppblock{
template</* ... */> struct basic_big_int { // example layout
  uint32_t \exposid{limb-count-and-sign}; // 31-bit size, 1-bit sign
  uint32_t \exposid{limb-capacity};       // if zero, inplace_storage is active
  union {
    uint64_t \exposid{inplace-storage}[/* ... */];
    uint64_t* \exposid{dynamic-storage};
  };
  constexpr span<const uint64_t> representation() const noexcept;
  // big_int is not a container: no begin(), no end()
};
}
}
}

\slide{
\slideh{Why sign and magnitude?}


\div(class="compact"){
\cowel_html_element("h4"){Why mandate a representation? Why no implementation freedom?}
\ul{
  \li{necessary for consistent algorithmic complexity, \tcode{noexcept}}
  \li{\b{Example}: \tcode{operator-} is \bigoh{1} with S&M, \bigoh{\math{\mi{n}}} with two's complement}
}

\cowel_html_element("h4"){Why sign and magnitude in particular?}
\ul{
  \li{industry standard, also in Boost.Multiprecision}
  \li{simpler \tcode{+}, \tcode{-}, \tcode{*}, \tcode{/} etc. \'EM DASH' separate sign & magnitude calculations}
  \li{negation and \tcode{abs} become \bigoh{1}}
  \li{\b{Downside}: bitwise ops emulate two's complement \q{on the fly}}
}
}
}

\slide{
\slideh{Small object optimization}

\ul{
  \li{\b{Idea}: store small integers in the container}
  \li{\b{Benefit}: avoid heap allocations for small values\ul{
    \li{much more beneficial than for \tcode{std::string}}
    \li{values outside 64-bit range are uncommon in many applications}
    \li{zero memory access for small \tcode{big_int} passed by register}
  }}
  \li{\b{Cost}: additional branches, more invalidation, possibly larger container}
  \li{customizable via \tcode{min_inplace_capacity} parameter\ul{
    \li{default should typically be \tcode{64} for \tcode{std::big_int}}
  }}
  \li{\ref("https://bemanproject.github.io/big_int/benchmarks.html#benchmarks_small_value_results"){benchmarks}:
    small \tcode{big_int} vs. builtin integer types}
}
}

\slide{
\slideh{Accessing the limb array}

\cppblock{
span<const uint_multiprecision_t> representation() const noexcept;
}

\ul{
  \li{\b{Motivation}: let user add \tcode{big_int} ops. without overhead\ul{
    \li{e.g. \tcode{popcount(const big_int&)} by counting bits in each limb}
    \li{pointer can be passed to runtime library, possibly GMP}
  }}
  \li{little-endian (least significant limb first) ⇒ cheap truncation/zero-ext.}
  \li{\b{Invariant}: always canonicalized (no trailing zero limbs)\ul{
    \li{canonicalize once on write ⇒ avoid trimming on every read}
  }}
  \li{invalidated by most operations, including move construction}
}
}

\slide{
\slideh{Operators are complicated}

\ul{
  \li{ops should not wastefully allocate:\ul{
    \li{in \tcode{(x+y+z)}, second addition should reuse alloc. of \tcode{x+y}}
    \li{user gets performance benefits without mental effort}
    \li{\tcode{x|=y} should modify limbs of \tcode{x} in-place if possible}
    \li{for large \tcode{_BitInt(N)} operands, no temporary \tcode{big_int} created}
  }}
  \li{different algorithms chosen at compile time:\ul{
    \li{use \tcode{_BitInt} if possible}
    \li{use simple algorithms to keep more code in runtime library}
  }}
  \li{different algorithms chosen based on limb count}
}
}

\slide{
\slideh{Operators \'EM DASH' Example of division}

\div(style="font-size: 80%"){
\cppblock{
template<class L, class R>
  constexpr \exposid{common-big-int-type}<L, R> operator/(L&& x, R&& y);
}

\ol{
  \li{If constant-evaluated, delegate to \tcode{_BitInt(N)} division if available}
  \li{Otherwise, if both are single-limb, use builtin division operator}
  \li{Otherwise, if right operand is single-limb, use short division (#1, #2)}
  \li{Otherwise, if both are ≤ 128-bit, use \tcode{__udivti3} for GCC and Clang}
  \li{Otherwise, if right operand is small, use long division (#3)}
  \li{Otherwise, use Burnikel–Ziegler sub-quadratic division\br
    (right operand ≥ 40 limbs on AArch64, ≥ 160 limbs on x86-64)}
}

\cppblock{
void short_div(span<u64> dest, span<const u64> x, u64 y);              // #1
void short_div(span<u64> x_dest, u64 y);                               // #2
void long_div (span<u64> dest, span<const u64> x, span<const u64> y);  // #3
}
}
}

\slide{
\slideh{Initialization and conversion}

\cppblock{
std::big_int x;              // default-init represents zero
std::big_int y = 1n + 1N;    // init using UDL
std::big_int z = 1;          // implicit int → big_int

auto a = std::big_int(1.0);  // explicit trunc. double → big_int
auto b = int(z);             // explicit trunc. big_int → int
auto c = double(z);          // explicit big_int → double

auto u = std::saturating_cast<int>(z);
std::string s = std::to_string(z); // std::format("{}", z)
std::from_chars(s.data(), s.data() + s.size(), z);
// ...
}
}

\slide{
\slideh{Library support}

Existing library facilities receive specializations/overloads:
\ul{
  \li{\tcode{std::hash} (hashing the integer value)}
  \li{\tcode{std::numeric_limits} (first class type to be supported)}
  \li{\tcode{std::in_range} (but not \tcode{std::cmp_*})}
  \li{\tcode{std::abs}, \tcode{std::gcd}, \tcode{std::lcm}, \tcode{std::midpoint}}
  \li{\tcode{std::saturating_cast} (but not rest of saturation arithmetic)}
  \li{\header{charconv}, \header{format}, and \tcode{std::to_string}}
}

\header{bit} support is omitted for now;
consider e.g. \tcode{std::countl_zero}.
}

\slide{
\slideh{Case study \'EM DASH' \tcode{std::abs}}

\div(style="font-size: 85%"){
\cppblock{
template<size_t b, class L, class A>
  constexpr basic_big_int<b, L, A> abs(const basic_big_int<b, L, A>& j);
template<size_t b, class L, class A>
  constexpr basic_big_int<b, L, A> abs(basic_big_int<b, L, A>&& j) noexcept;
}
}

\ul{
  \li{all specializations supported, not just \tcode{std::big_int}}
  \li{multiple overloads better than forwarding reference\ul{
    \li{only one instantiation for lvalues and \tcode{const} lvalues}
  }}
  \li{\tcode{noexcept} because of sign and magnitude representation\ul{
    \li{\tcode{std::abs} clears the sign bit and returns \tcode{j}}
  }}
  \li{does \header{cstdlib} provide \tcode{std::big_int} now?}
}
}

\slide{
\slideh{User-defined literals}

\cppblock{
// in namespace std::literals::big_int_literals
template<char... digits>
  constexpr big_int operator""n() noexcept(/* ... */);
// also operator""N
}

\ul{
  \li{provides notation \tcode{123n}, \tcode{0xFFN}, etc.}
  \li{\q{manual parsing} during constant evaluation into limb array}
  \li{… followed by constructing \tcode{big_int} at runtime}
  \li{compiler support worth exploring:}
}

\cppblock{
constexpr big_int operator""n(const uint_multiprecision_t*, size_t);
}
}

\slide{
\slideh{Challenges specific to standardization}

\ul{
  \li{increased complexity of any future integer utility (like \tcode{std::simd})}
  \li{high implementation effort, especially for numeric parts\ul{
    \li{\b{Possible solution}: factor out portion into third-party component}
    \li{\tt{beman.big_int} has some hand-written assembly}
    \li{precedent provided by Boost.Math}
  }}
  \li{\tcode{big_int} ABI would be hard to change}
  \li{\tcode{big_int} overloads bloat lightweight headers like \header{charconv}}
  \li{ecosystem remains fragmented at first (see \ref("https://xkcd.com/927/"){xkcd \'EM DASH' Standards})}
}
}

\slide{
\slideh{Implementation experience}

\ul{
  \li{full reference implementation at \ref("https://github.com/bemanproject/big_int"){\sans{beman.big_int}}}
  \li{heavily inspired by Boost.Multiprecision, but\ul{
    \li{\tcode{constexpr} out of the box, no \tcode{union} type punning}
    \li{significant modernization using C++23, more lightweight}
  }}
  \li{rigorously tested, 92% test coverage}
}

\div(class="compact"){
\cowel_html_element("h4"){Performance
  (\ref("https://bemanproject.github.io/big_int/benchmarks.html#benchmarks_libraries"){benchmarks})}
\ul{
  \li{nearly uniformly better than Boost \tcode{cpp_int}}
  \li{generally behind Boost \tcode{gmp_int},
    but ahead across wide size ranges of some operations}
}
}
}

\slide{
\slideh{Error handling}

\ul{
  \li{errors can be \q{numeric errors} or \q{container errors}}
  \li{functions are \tcode{noexcept} if neither can occur}
}

\div(class="compact"){
\cowel_html_element("h4"){Numeric errors}
\ul{
  \li{\b{Cause}: division by zero, conversion of infinity to \tcode{std::big_int}, etc.}
  \li{\b{Effect}: undefined behavior}
}

\cowel_html_element("h4"){Container errors}
\ul{
  \li{\b{Cause}: exceeding \tcode{max_size()}, allocation failure}
  \li{\b{Effect}: exception (e.g. \tcode{std::bad_alloc})}
}
}
}

\slide{
\slideh{Naming}

\style{
.compact h3,
.compact h4 {
  margin-bottom: 0.0;
}
.compact ul {
  margin-top: 0;
  margin-top: 0;
}
}

\div(class="compact"){
\cowel_html_element("h4", (class="subh")){\tcode{std::big_int}}
\ul{
  \li{almost every standard lib. in other languages uses \q{big integer}}
  \li{\tcode{std::integer} is unclear, confusable with concept like \tcode{std::integral}}
}

\cowel_html_element("h4"){\tcode{operator""n} / \tcode{operator""N}}
\ul{
  \li{chosen for symmetry with JavaScript}
}

\cowel_html_element("h4"){\tcode{std::uint_multiprecision_t}}
\ul{
  \li{seems more fitting and focused than \q{limb type}}
  \li{name deliberately long; type is necessary \tcode{std::intmax_t}-like evil}
}
}
}

\slide{
\slideh{Future direction \'EM DASH' What comes after P4444?}

\div(class="compact"){
\cowel_html_element("h4"){Language support}
\ul{
  \li{\tcode{template<std::big_int>}}
  \li{better language support for \tcode{operator""n}}
  \li{non-transient allocations (\tcode{constexpr std::big_int} variables)}
}

\cowel_html_element("h4"){Library support}
\ul{
  \li{new integer numeric functions (e.g. \tcode{std::ipow})}
  \li{additional constructors (e.g. from integer and exponent)}
  \li{manipulating and iterating over individual bits}
  \li{\header{random} support, possibly just distributions}
}
}
}

\slide{
\slideh{⛔ Why no expression templates?}

\b{Idea}:
Expressions return a symbolic object (\tcode{std::big_int_expre\'SHY'ssion<...>})
instead of \tcode{std::big_int}.
This allows transformations:

\cppblock{
abs(abs(x))    →  abs(x)
pow(x, y) % m  →  pow_mod(x, y, m)
}

\div(class="compact"){
\cowel_html_element("h4"){Problems}
\ul{
  \li{increased complexity, maintenance burden, compile-time overhead}
  \li{countless rules, special cases to be memorized by user}
  \li{unreliable if optimizations optional, otherwise unfit for ISO process}
  \li{bad interaction with \tcode{auto}, lifetime issues}
}
}
}

\slide{
\slideh{⛔ Why no \tcode{std::big_int_view}?}

\div(class="compact"){
\b{Idea}:
Provide non-owning type (in addition or instead),
similar to \tcode{std::string_view}.

\cowel_html_element("h4"){Problems}
\ul{
  \li{\tcode{big_int_view} parameter cannot accept large \tcode{_BitInt}}
  \li{provides not allocator for result\ul{
    \li{analogous to lacking \tcode{operator+} between \tcode{std::string_view}}
    \li{only read-only operations are possible, no \tcode{+}, \tcode{-}, \tcode{*}, \tcode{/}, etc.}
  }}
  \li{provides no scratch space allocator}
}
}
}

\slide{
\slideh{⛔ Why no \tcode{std::big_uint}?}

\b{Idea}:
Provide unsigned variant of \tcode{std::big_int}.

\div(class="compact"){
\cowel_html_element("h4"){Problems}

\ul{
  \li{bifurcation of ecosystem and APIs}
  \li{harmful to use of \tcode{std::big_int} as vocabulary type}
  \li{storing sign bit is cheap ⇒ unsigned variant adds little value}
  \li{overflow on subtraction}
}
}
}

\bib(
  id = "N1692",
  title = "A Proposal to add the Infinite Precision Integer to the C++ Standard Library",
  date = "2004-07-01",
  author = "M.J. Kronenburg",
  link = "https://wg21.link/n1692",
  long_link = "https://www.open-std.org/jtc1/sc22/wg21/docs/papers/2004/n1692.pdf",
)\
