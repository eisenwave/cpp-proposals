\slide{
\slideh{Motivation}

\ol{
  \li{\tcode{big_int} is needed to represent large numbers\ul{
    \li{sometimes \dfn{potentially big}, sometimes \dfn{actually big}}
    \li{serialization, scientific computing, cryptography, …}
  }}
  \li{\tcode{big_int} is a vocabulary type}
  \li{\tcode{big_int} enables \q{\tt{rational}}, \q{\tt{big_float}}, and \q{\tt{big_decimal}}}
  \li{\tcode{big_int} makes correctness easy}
  \li{\tcode{big_int} is extremely platform-dependent and hard to implement\ul{
    \li{
      \tt{beman.big_int} has > 1000
      \tcode{#if}, \tcode{#elif}, and \tcode{if constexpr}
    }
  }}
}
}

\slide{
\slideh{\tt{big_int} is a vocabulary type}

