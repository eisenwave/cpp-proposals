\slide{
\cowel_html_element("h1"){\tcode{std::big_int}\br
\span(id="docnum"){P4444R1}}
}

\slide{
\slideh{Introduction}

\tcode{std::big_int} is an \dfn{arbitrary-precision},
\dfn{elastic}, numeric class type.

\cppblock{
#include <big_int>

std::big_int x = 1n << 1'000'000; // \cowel_highlight_as("comment"){\math{\msup{\mn{2}\mn{1,000,000}}}}
}

\dl{
  \dt{arbitrary-precision}
  \dd{
    It has no fixed size.
    It can represent arbitrarily large integers (up to \tcode{max_size()}).
    If needed, dynamic allocations take place.
  }

  \dt{elastic}
  \dd{
    It grows and shrink as needed without explicit request to fit the result.
  }
}
}

\slide{
\slideh{History}

\ul{
  \li{Several prior proposals tried to standardize \tcode{std::integer}:\ul{
    \li{\ref("N1692") (2004), \ref("N1744") (2005), \ref("N2143") (2007)}
    \li{all abandoned, despite positive reception}
  }}
  \li{Meanwhile, arbitrary-precision integer support becomes the norm:\ul{
    \li{
      \b{Builtin}: Python, Ruby, Lisp, Scheme, Racket, Clojure,
      Haskell, Prolog, Wolfram Language, Maxima, Erlang, JavaScript, TypeScript
    }
    \li{
      \b{Standard library}:
      Java, Kotlin, Julia, C#, F#, Visual Basic .NET, Go, Perl, Ada, Zig, Standard ML, MATLAB, PHP
    }
  }}
  \li{third-party solutions like Boost.Multiprecision in C++}
}
}

