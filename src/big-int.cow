\h4(show_number=false){[numeric.special]}

Insert a new paragraph at the end of \eelis{numeric.special} as follows:

\Bins{
The specialization for \tcode{basic_big_int}\iref{big.int}
shall be provided as follows:

\itemdecl{
namespace std {
  template<size_t b, class L, class A> class numeric_limits<basic_big_int<b, L, A>> {
  private:
    using \exposid{value-type} = basic_big_int<b, L, A>;
  public:
    static constexpr bool is_specialized = true;
    static constexpr \exposid{value-type} min() noexcept { return 0; }
    static constexpr \exposid{value-type} max() noexcept { return 0; }
    static constexpr \exposid{value-type} lowest() noexcept { return 0; }

    static constexpr int  digits = 0;
    static constexpr int  digits10 = 0;
    static constexpr int  max_digits10 = 0;

    static constexpr bool is_signed = true;
    static constexpr bool is_integer = true;
    static constexpr bool is_exact = true;
    static constexpr int  radix = 2;
    static constexpr \exposid{value-type} epsilon() noexcept { return 0; }
    static constexpr \exposid{value-type} round_error() noexcept { return 0; }

    static constexpr int  min_exponent = 0;
    static constexpr int  min_exponent10 = 0;
    static constexpr int  max_exponent = 0;
    static constexpr int  max_exponent10 = 0;

    static constexpr bool has_infinity = false;
    static constexpr bool has_quiet_NaN = false;
    static constexpr bool has_signaling_NaN = false;
    static constexpr \exposid{value-type} infinity() noexcept { return 0; }
    static constexpr \exposid{value-type} quiet_NaN() noexcept { return 0; }
    static constexpr \exposid{value-type} signaling_NaN() noexcept { return 0; }
    static constexpr \exposid{value-type} denorm_min() noexcept { return 0; }

    static constexpr bool is_iec559 = false;
    static constexpr bool is_bounded = false;
    static constexpr bool is_modulo = false;

    static constexpr bool traps = false;
    static constexpr bool tinyness_before = false;
    static constexpr float_round_style round_style = round_toward_zero;
  };
}
}
}

