\Babstract{

}

\h2(listed=false){Contents}

\make_contents

\h2{Introduction}

The C++ standard library is currently lacking an elementary operation
for decomposing floating-point numbers into integers.
Such an operation is useful for a wide variety of applications,
internally present in standard libraries already,
and should be exposed to the user.

The C23 standard draft \ref("N3220")
describes the model of floating-point numbers in
§5.2.5.3.3 as follows:
\Bquote{
The following parameters are used to define the model for each floating type:

\style{
#float-parameters,
#float-parameters tr,
#float-parameters tbody,
#float-parameters td {
  border: none;
}

math[display=block] {
  font-size: 125%;
}
}
\table(id="float-parameters"){
  \tr{
    \td{\math{\mi{s}}}
    \td{sign (\math{\mo{±}\mn{1}})}
  }
  \tr{
    \td{\math{\mi{b}}}
    \td{
      base or radix of exponent representation
      (an integer \math{\mo{>}\mn{1}})
    }
  }
  \tr{
    \td{\math{\mi{e}}}
    \td{
      exponent (an integer between
      a minimum \math{\msub{\mi{e}\mi{min}}} and
      a maximum \math{\msub{\mi{e}\mi{max}}})
    }
  }
  \tr{
    \td{\math{\mi{p}}}
    \td{precision (the number of base-\math{\mi{b}} digits in the significand)}
  }
  \tr{
    \td{\math{\msub{\mi{f}\mi{k}}}}
    \td{nonnegative integers less than \math{\mi{b}} (the significand digits)}
  }
}

For each floating type, the parameters \math{\mi{b}}, \math{\mi{p}},
\math{\msub{\mi{e}\mi{min}}}, and \math{\msub{\mi{e}\mi{max}}} are fixed constants.

For each floating type,
a \dfn{floating-point number} (\math{\mi{x}}) is defined by
the following model:

\mathblock{
  \mi{x}
  \mspace(width="0.25em"){}\mi{=}\mspace(width="0.25em"){}
  \mi{s}
  \msup{\mrow{\mi{b}}\mrow{\mi{e}}}
  \munderover{
    \mi{∑}
    \mrow{\mi{k}\mi{=}\mn{1}}
    \mi{p}
  }
  \msub{\mi{f}\mi{k}}
  \msup{\mi{b}\mrow{\mi{−}\mi{k}}}
  \mi{,}\mspace(width="1em"){}
  \msub{\mi{e}\mi{min}}
  \mspace(width="0.15em"){}\mi{≤}\mspace(width="0.15em"){}
  \mi{e}
  \mspace(width="0.15em"){}\mi{≤}\mspace(width="0.15em"){}
  \msub{\mi{e}\mi{max}}
}
}

Or more simply and ignoring the exponent constraints,
one could say:
\mathblock{
  \mi{x}
  \mspace(width="0.25em"){}\mi{=}\mspace(width="0.25em"){}
  \mi{s}
  \msup{\mrow{\mi{b}}\mrow{\mi{e}}}
  \mi{q}
  \mi{,}\mspace(width="1em"){}
  \mi{q}
  \mo{∈}
  \mi{ℕ}
}

This decomposition is not just a theoretical basis,
but relevant in practice for implementing floating-point operations.

\Bex{
To implement \tcode{std::scalbn(double \math{\mi{x}}, int \math{\mi{n}})}
(which multiplies \math{\mi{x}} with
\math{\msup{\mi{b}\mi{n}}} given \math{\mi{n}}), one needs to
\ol{
  \li{decompose \math{\mi{x}} into its floating-point components}
  \li{adjust the exponent by \math{\mi{n}}, and}
  \li{recompose the floating-point number with the adjusted exponent.}
}
}

\Bex{
To implement \tcode{std::to_chars} with output in hex notation,
where \math{\mrow{\mi{b}\mo{=}\mn{2}}}, one needs to:
\ol{
  \li{decompose the input into its floating-point components,}
  \li{bit-shift and convert the significand (integer) to hexadecimal digits,}
  \li{add/remove trailing zeros and/or insert a decimal point, and}
  \li{print '\tt{p}' followed by the (adjusted) exponent in decimal.}
}

Of course, this is a gross simplification,
and decomposing the floating-point number happens in decimal notation too,
but there is a less direct relationship between the significand and the printed digits.
}

Frustratingly, this decomposition is already implemented in standard libraries,
just not exposed to the user.
It is also difficult for the user to implement this operation manually,
especially with good performance.
The standard library only offers much higher level operations such as
\tcode{std::frexp}
(which decomposes into a normalized fraction in ranges ±[0.5, 1) and an exponent);
it does not provide the low-level building block that could be used to implement
\tcode{std::frexp}, \tcode{std::scalbn}, \tcode{std::to_chars}, etc.

I therefore propose adding \tcode{std::decompose_float} function.

\h2{Motivation}

The key benefit of a \tcode{std::decompose_float} function
is that it allows the user to implement floating-point operations
without needing special knowledge about the layout of the floating-point type.

\Bex{
When implementing a conversion from a \tcode{float} to a \tcode{BigInt} type
(i.e. an arbitrary-precision integer),
one would need to split the \tcode{float}
into an integer \math{\mi{q}} and binary exponent \math{\mi{e}}, then
\cppblock{
return \tcode{BigInt(\math{\mi{q}}) * pow(\math{\mi{b}}, BigInt(\math{\mi{q}})}); // << \math{\mi{e}} for binary floats
}

This approach can be found in various arbitrary-precision arithmetic libraries in practice.
}

\h2{Design}

The signature of the function is as follows:

\cppblock{
template<class F>
struct float_decomposition {
private:
  static constexpr bool \exposid{is-iec559} = numeric_limits<F>::is_iec559;
public:
  // radix for the result of exponent()
  static constexpr int radix = numeric_limits<F>::radix;

  // lowest possible result of exponent()
  static constexpr int min_exponent_result = \exposid{implementation-defined};
  // greatest possible result of exponent()
  static constexpr int max_exponent_result = \exposid{implementation-defined};
  // greatest possible result of exponent() for finite values
  static constexpr int max_finite_exponent_result = \exposid{implementation-defined};

  // greatest possible result of significand()
  static constexpr int max_significand = \exposid{implementation-defined};
  // bit width of greatest possible significand() result,
  // which may be lower than the width of significand_type
  static constexpr int significand_width = \exposid{implementation-defined};

  using significand_type = \exposid{unsigned integer type};

  constexpr int              sign() const noexcept;        // returns -1 or 1
  constexpr bool             sign_bit() const noexcept;    // returns std::signbit(x)
  constexpr int              exponent() const noexcept;    // returns base-radix exponent
  constexpr significand_type significand() const noexcept;

  constexpr bool is_finite() const noexcept requires \exposid{is-iec559};
  constexpr bool is_inf() const noexcept requires \exposid{is-iec559};
  constexpr bool is_nan() const noexcept requires \exposid{is-iec559};
  constexpr bool is_normal() const noexcept requires \exposid{is-iec559};
  constexpr bool is_signaling() const noexcept requires \exposid{is-iec559};
  constexpr bool is_subnormal() const noexcept requires \exposid{is-iec559};
  constexpr bool is_zero() const noexcept;
};

template<class T>
constexpr float_decomposition<T> decompose_float(const T& x) noexcept; // freestanding
}

A lot of design questions can be quickly answered in a few sentences:

\dl{
  \dt{Why is \tcode{float_decomposition} not simply an aggregate?}
  \dd{
    Because this gives the implementation more flexibility regarding the layout,
    including the use of bit-fields.
    Also, structured bindings would be undesirable due to potential bugs
    from getting the order of the members wrong.
  }

  \dt{Why is it \tcode{constexpr}?}
  \dd{
    Most floating-point operations
    (but especially inspection operations like \tcode{std::isinf})
    are already \tcode{constexpr}, so this one should be as well.
  }

  \dt{Why is it freestanding?}
  \dd{
    The operation is elementary and does not raise any floating-point exceptions,
    nor does it interact with \tcode{errno}.
    There is no technical reason it couldn't or shouldn't be freestanding.
  }

  \dt{What is \tcode{significand_type}?}
  \dd{
    It is an implementation-defined unsigned integer type.
    This is needed because there are types such as \tcode{std::float128_t}
    where the result would not fit into other types like \tcode{unsigned long long}.
  }

  \dt{Why does \tcode{exponent()} return \tcode{int}?}
  \dd{
    Because \tcode{int} is sufficient for every real-world floating-point format,
    even if it has the minimum width of 16 bits.
    \tcode{std::float128_t} has only 15 exponent bits.
    The return type can be changed in the future should a floating-point format ever emerge
    that requires more than \tcode{int} can provide.
  }

  \dt{Why is \tcode{radix} provided as a static member?}
  \dd{
    Of all the \tcode{numeric_limits} properties,
    \tcode{radix} is the most important property in this context.
    It provides the minimum knowledge required for \tcode{float_decomposition}
    to be interpreted correctly.
    That justifies providing easy access to it.
  }

  \dt{Should \tcode{float_decomposition} not have a constructor?}
  \dd{
    No, the implementation might internally have a constructor,
    but there is no need to provide a user-exposed one.
    If there was a constructor taking, say, \tcode{F},
    this would just create competing styles where some people \q{skip}
    \tcode{std::decompose_float}.
    Any other constructor provides pointless implementation work.
    As mentioned, there is a lot of representation freedom,
    so there might not even be a constructor,
    with all initialization taking place via \tcode{std::bit_cast<std::float_decomposition>}.
  }
}

More involved design questions are addressed below.

\h3{Handling of non-finite inputs}

Firstly, it should be noted that determining whether a number is finite
is typically extremely fast and would be a side product of the decomposition process.
ISO/IEC 60555 binary interchange floating-point types are
non-finite if and only if the exponent consist of all one-bits.

\Bex{
The finiteness check for \tcode{std::float32_t x}
within \tcode{std::decompose_float} boils down to:
\cppblock{
// if (!std::isfinite(x))
if ((std::bit_cast<std::uint32_t>(x) << 1) >= 0xff000000) [[unlikely]] {
  // ...
}
}
The \tcode{bit_cast} is essentially a no-op and performed anyway,
the left-shift and integer comparison are extremely cheap operations,
and the branch should be easily predictable,
with the finite path being favored.
}

In the even that even this tiny check is too costly,
it can be eliminated via \tcode{[[assume(std::isfinite(x))]]} up front.

The question is then what \tcode{std::decompose_float}
should do for non-finite inputs.
The most useful behavior were if
\ul{
  \li{
    \tcode{significand()}
    simply returned the contents of the significand representation
    reinterpreted as an integer.
    This is useful for examining NaN payloads.
  }
  \li{
    \tcode{exponent()}
    returned the exponent adjusted using the same bias as for finite numbers.
    For ISO/IEC 60559 binary interchange floating-point types,
    this means that the exponent of ±infinity would be greater than that of any finite numbers,
    which makes comparisons of \tcode{exponent()} between results meaningful,
    unless NaN is involved.
  }
}

\h3{Why not a \tt{<cmath>} function?}

Another design option would be to go through WG14 and
standardize a quantized function
similar to \tcode{frexp}, like:

\cppblock{
double frexpq(double x, int* exp) {
  // sample implementation assuming that numeric_limits<double>::radix == 2
  double d = std::frexp(x, &exp);
  exp -= std::numeric_limits<double>::digits;
  return std::ldexp(d, std::numeric_limits<double>::digits);
}
}

Unlike \tcode{frexp},
which returns a normalized fraction,
this could return a number that is always a (small) integer.
The significand integer can then be obtained via \tcode{static_cast},
and that conversion would always be exact given an integer
with enough bits to represent the significand (except for non-finite inputs).

The key reason against this direction
is that \tcode{frexpq} does only a portion of the work.

\Bex{
Consider how to actually implement a \tcode{BigInt} constructor
as in the motivating example with \tcode{BigInt} in \ref("#motivation")
using the hypothetical \mark{\tcode{std::frexpq}}
vs. the hypothetical \mark{\tcode{std::decompose_float}}:

\cppblock{
struct BigInt {
  // typical BigInt implementations use a sign-and-magnitude representation
  bool sign;
  unsigned long* limbs;

  BigInt(std::unsigned_integral auto value, bool sign)
    : sign(sign), limbs(do_alloc_limb_array(value)) {}

#ifdef USE_FREXPQ
  BigInt(std::float64_t x) : BigInt(0, false) {
    if (!std::isfinite(x)) {
      throw std::invalid_argument("non-finite input");
    }
    int e;
    double xi = \mark{std::frexpq}(x, &e);
    *this = BigInt(static_cast<std::uint64_t>(std::fabs(xi)), std::signbit(xi));
    *this <<= e;
  }
#else
  BigInt(std::float64_t x) : BigInt(0, false) {
    auto d = \mark{std::decompose_float}(x);
    if (!d.is_finite()) {
      throw std::invalid_argument("non-finite input");
    }
    *this = BigInt(d.significand(), d.sign_bit());
    *this <<= d.exponent();
  }
#endif

  BigInt& operator<<=(int s) {
    if (s > 0) do_shift_left(s);
    if (s < 0) do_shift_right(-s);
    return *this;
  }
  // ...
};
}

The key observation is that \tcode{std::decompose_float} does the work
of four functions simultaneously:
\ul{
  \li{
    \tcode{std::frexpq}, by yielding the significand as an integer
    as well as the corresponding base-2 exponent;
  }
  \li{
    \tcode{std::isfinite}, by identifying infinities and NaNs by their exponent;
  }
  \li{
    \tcode{std::fabs}, by splitting the sign bit from the significand; and
  }
  \li{
    \tcode{std::signbit}, by extracting the sign bit separately.
  }
}
}

Miraculously, \tcode{std::decompose_float}
is also a potentially cheaper operation than \tcode{std::frexpq}
despite being vastly more useful.
Specifically, \tcode{std::frexpq}
would be required to normalize subnormal normals
rather than merely adjusting the exponent like for normal numbers.
By comparison,
\tcode{std::decompose_float}
can reinterpret the significand of both zeros and subnormal numbers directly.

In summary, \tcode{std::decompose_float} is the better solution
for decomposing floating-point numbers because
\ul{
  \li{
    it provides a cleaner interface; and
  }
  \li{
    it is a swiss-army knife that tends to solve several problems simultaneously,
    like computing \tcode{std::frexpq}, \tcode{std::fabs}, and
    various boolean tests simultaneously; and
  }
  \li{
    it does not waste any work,
    whereas \tcode{std::frexpq} needs to test whether a number is subnormal or infinity
    but stores an unspecified value in \tcode{*e} for such inputs
    (perhaps it could be defined not to waste this work,
    but \tcode{std::frexp} stores an unspecified value,
    so \tcode{std::frexpq} should presumably behave the same); and
  }
  \li{
    it is easy to implement a variety of operations on top of \tcode{std::decompose_float},
    but not on top of \tcode{std::frexpq};
    for example, \tcode{std::frexpq}
    does not seem like it should be involved in \tcode{std::signbit},
    but \tcode{std::signbit(x)} is \tcode{std::decompose_float(x).sign_bit()}; and
  }
  \li{
    it has cheaper handling of subnormals
    because it can reinterpret the significand directly,
    suggesting that it is a lower-level or more elementary operation; and
  }
  \li{
    it is safer: since \tcode{std::frexpq} requires the user to perform conversion
    to an integer type themselves, it presents a safety hazard
    if a user chooses an insufficient type and the conversion results in UB.
  }
}

\h2{Wording}

The changes are relative to \ref("N5054").

\h3(show_number=false){[version.syn]}

Add a feature-test macro to \eelis{version.syn} as follows:

\Bins{
\itemdecl{
#define __cpp_lib_decompose_float 20XXXXL // \serif{freestanding, also in \tt{<header>}}
}
}

\cowel_macro("internal_ref"){\cowel_to_html{\ref("#\cowel_put"){[\cowel_put]}}}

\h3(show_number=false){[float.decompose]}

\Bins{
\cowel_html_element("h2"){Floating-point decomposition \stable_ref{float.decompose}}

¶
\tcode{float_decomposition} objects
store information about individual components of
the value representation of an object of floating-point type \tcode{T}.
This value representation is called the \dfn{underlying value}
of the \tcode{float_decomposition} object.
Copying and assigning such objects copies and assigns their underlying value,
respectively.

¶
A specialization of \tcode{float_decomposition}
exists for every cv-unqualified floating-point type\iref{basic.fundamental}.
Each such specialization is a standard-layout, trivially copyable class type.

¶
A program is ill-formed
if it defines a specialization of \tcode{float_decomposition}
or instantiates a specialization \tcode{float_decomposition<T>}
where \tcode{T} is not a cv-unqualified floating-point type.

¶
Throughout this subclause,
requirements specific to
ISO/IEC 60559 binary interchange floating-point types,
also apply to \tcode{bfloat16_t}, if provided.

\itemdecl{
template<class T> struct float_decomposition {
  //\serif{ \internal_ref{float.decompose.properties}, properties}
  using value_type = T;
  using significand_type = \seebelow;

  static constexpr int radix = numeric_limits<T>::radix;
  static constexpr int min_exponent_result;
  static constexpr int max_exponent_result;
  static constexpr int max_finite_exponent_result;

  static constexpr significand_type max_significand;
  static constexpr int significand_width = bit_width(max_significand);

  //\serif{ constructors}
  constexpr float_decomposition() : float_decomposition(compose_float(T{})) {}

  //\serif{ \internal_ref{float.decompose.accessors}, accessors}
  constexpr int              sign() const noexcept;
  constexpr int              exponent() const noexcept;
  constexpr significand_type significand() const noexcept;
  constexpr explicit operator value_type() const noexcept; //\serif{ optional}

  //\serif{ \internal_ref{float.decompose.boolean}, boolean properties}
  constexpr bool sign_bit() const noexcept;
  constexpr bool is_zero() const noexcept;
  constexpr bool is_finite() const noexcept;               //\serif{ optional}
  constexpr bool is_inf() const noexcept;                  //\serif{ optional}
  constexpr bool is_nan() const noexcept;                  //\serif{ optional}
  constexpr bool is_normal() const noexcept;               //\serif{ optional}
  constexpr bool is_signaling() const noexcept;            //\serif{ optional}
  constexpr bool is_subnormal() const noexcept;            //\serif{ optional}
};

//\serif{ \internal_ref{float.decompose.function}, function \tcode{decompose_float}}
template<class T>
  constexpr float_decomposition<T> decompose_float(const T& x) noexcept;
}
}

\h3(show_number=false){[float.decompose.properties]}

\Bins{
\cowel_html_element("h3"){Properties \stable_ref{float.decompose.properties}}

\itemdecl{
static constexpr int min_exponent_result;
}

\itemdescr{
¶
\returns
The lowest possible result of \tcode{exponent()}.
}

\itemdecl{
static constexpr int max_exponent_result;
}

\itemdescr{
¶
\returns
The greatest possible result of \tcode{exponent()}.
}

\itemdecl{
static constexpr int max_finite_exponent_result;
}

\itemdescr{
¶
\returns
The greatest possible result of \tcode{exponent()}
if the underlying value is finite.
}

\itemdecl{
using significand_type = \exposid{implementation-defined};
}

\itemdescr{
¶
An implementation-defined unsigned integer type\iref{basic.fundamental}
capable of representing all possible results of \tcode{significand()}.
A specialization of \tcode{float_decomposition<T>} is ill-formed
if no such integer type exists.
}

\itemdecl{
static constexpr significand_type max_significand;
}

\itemdescr{
¶
The greatest possible result of \tcode{significand()}.

\note{
This includes results of \tcode{significand()}
where implicit bits have been concatenated to significand bits present
in the value representation of an underlying value.
If \tcode{T} is an ISO/IEC 60559 binary interchange floating-point type,
\tcode{significand_width} equals \tcode{numeric_limits<T>::digits + 1}.
}
}
}

\h3(show_number=false){[float.decompose.accessors]}

\Bins{
\cowel_html_element("h3"){Accessors \stable_ref{float.decompose.accessors}}

¶
Function \tcode{operator value_type}
is provided if \tcode{T} is an ISO/IEC 60559 binary interchange floating-point type.
Otherwise, it is conditionally supported.

\itemdecl{
constexpr int sign() const noexcept;
}

\itemdescr{
¶
\returns
\tcode{sign_bit() ? -1 : 1}.
}

\itemdecl{
constexpr int exponent() const noexcept;
constexpr significand_type significand() const noexcept;
}

\itemdescr{
¶
Let \math{\mi{x}} be the underlying value.
Let \math{\mi{b}} be \tcode{radix}.

¶
\effects
\ul{
  \li{
    If \math{\mi{x}} is finite,
    \tcode{exponent()} returns \math{\mi{e}} and
    \tcode{significand()} returns \math{\mi{m}} respectively, such that
    \math{
    \mrow{
      \mo(form="prefix", fence=true, stretchy=false, rspace="0"){|}
      \mi{x}
      \mo(form="suffix", fence=true, stretchy=false, lspace="0"){|}
      \mo{=}
      \mi{m}
      \mo{×}
      \msup{\mi{b}\mi{e}}}
    }.
    Which combination of \math{\mi{e}} and \math{\mi{m}} is chosen
    is a property of the implementation,
    except that \math{\mi{m}} is chosen to be representable in type \tcode{T}.
    \br\note{
    Ignoring \q{subnormal flushing},
    \math{\mi{x}} equals \tcode{copysign(scalbn(significand(), exponent()), T(sign()))}.
    }
  }
  \li{
    Otherwise, if \tcode{T} is an ISO/IEC 60559 binary interchange floating-point type
    and \math{\mi{x}} is negative or positive infinity,
    \tcode{exponent()} returns \tcode{max_exponent_result} and
    \tcode{significand()} returns zero.
  }
  \li{
    Otherwise, if \tcode{T} is an ISO/IEC 60559 binary interchange floating-point type
    and \math{\mi{x}} is NaN,
    \tcode{exponent()} returns \tcode{max_exponent_result} and
    \tcode{significand()} returns the NaN payload of \math{\mi{x}},
    reinterpreted as an integer.
  }
  \li{
    Otherwise, the result of \tcode{exponent()} and
    \tcode{significand()} is derived from \math{\mi{x}}
    in an implementation-defined manner.
  }
}

¶
\remarks
If two \tcode{float_decomposition} objects have the same underlying value,
their respective \tcode{exponent()} and \tcode{significand()} results are equal.

¶
\recommended
If \tcode{T} is not an ISO/IEC 60559 binary interchange floating-point type
but has similar representation,
implementations should return the same results
as if \tcode{T} were an ISO/IEC 60559 binary interchange floating-point type.
}

\itemdecl{
constexpr explicit operator value_type() const noexcept;
}

\itemdescr{
¶
\returns
The underlying value.

¶
\remarks
Floating-point exceptions may be raised,
the conversion may be inexact,
and the NaN payload may not be preserved.
\tcode{signbit(static_cast<value_type>(*this))} equals \tcode{sign_bit()}.
}
}

\editnote{
The \recommended paragraph addresses the case of x87 80-bit \tcode{long double},
which is not an ISO/IEC 60559 binary interchange floating-point type,
but is very similar to such a format;
it provides infinities and NaNs,
but has an explicit integer significand bit.
}

\h3(show_number=false){[float.decompose.boolean]}


\Bins{
\cowel_html_element("h3"){Boolean accessors \stable_ref{float.decompose.boolean}}

¶
Of the following member functions,
\tcode{sign_bit} and \tcode{is_zero} are always present;
the others are present if \tcode{numeric_limits<T>::is_iec559} is \tcode{true}
and conditionally supported otherwise.

\itemdecl{
constexpr bool sign_bit() const noexcept;
constexpr bool is_zero() const noexcept;
constexpr bool is_finite() const noexcept;
constexpr bool is_inf() const noexcept;
constexpr bool is_nan() const noexcept;
constexpr bool is_normal() const noexcept;
constexpr bool is_signaling() const noexcept;
constexpr bool is_subnormal() const noexcept;
}

¶
\returns
\tcode{\exposid{test-fun}(\math{\mi{x}})}, where
\tcode{\exposid{test-fun}} is the corresponding function in \header{cmath}
with the underscore in the name removed, and
\math{\mi{x}} is the underlying value.
}

\h3(show_number=false){[float.decompose.function]}

\Bins{
\cowel_html_element("h3"){Function \tcode{decompose_float} \stable_ref{float.decompose.function}}

\itemdecl{
template<class T>
  constexpr float_decomposition<T> decompose_float(const T& x) noexcept;
}

\itemdescr{
¶
\constraints
\tcode{T} is a cv-unqualified floating-point type.

¶
\returns
A \tcode{float_decomposition<T>} object whose underlying value is \tcode{x}.

¶
\remarks
No floating-point exceptions are raised, and
no inexact operation takes place.
}
}

\h2(show_number=false){Appendix \'EM DASH' Sample implementations}

\h3(
  id="impl-decompose-float",
  show_number=false,
){\tt{decompose_float(float64_t)}}

\cppblock{
struct f64_decomposition {
  static constexpr int radix = 2;
  static constexpr int min_exponent_result = -1074;
  static constexpr int max_exponent_result = 972;
  static constexpr int max_finite_exponent_result = 971;
  static constexpr int max_significand = (1ull << 53) - 1;
  static constexpr int significand_width = 53;
  using significand_type = uint64_t;

  uint64_t m;
  int e;
  bool s;

  constexpr int              sign() const noexcept { return s ? -1 : 1; }
  constexpr bool             sign_bit() const noexcept { return s; }
  constexpr int              exponent() const noexcept { return e; }
  constexpr significand_type significand() const noexcept { return m; }

  constexpr bool is_finite() const noexcept {
    return e != max_exponent_result;
  }
  constexpr bool is_inf() const noexcept {
    return !is_finite() && m == 0;
  }
  constexpr bool is_nan() const noexcept {
    return !is_finite() && m != 0;
  }
  constexpr bool is_normal() const noexcept {
    return e != max_exponent_result && e != min_exponent_result;
  }
  constexpr bool is_signaling() const noexcept {
    return is_nan() && m & (1ull << 51) == 0;
  }
  constexpr bool is_subnormal() const noexcept {
    return e == min_exponent_result;
  }
  constexpr bool is_zero() const noexcept {
    return e == min_exponent_result && m == 0;
  }
};

constexpr f64_decomposition decompose_float(float64_t x) {
  // exponent bias + significand bits
  constexpr int exponent_bits = 11;
  constexpr int significand_bits = 52;
  constexpr int exponent_offset = 1023 + significand_bits;
  constexpr int min_exponent = -1022 - significand_bits;

  constexpr uint64_t significand_mask = (1ull << significand_bits) - 1;
  constexpr uint64_t implicit_significand_bit = 1ull << significand_bits;
  constexpr int exponent_shifted_mask = (1 << exponent_bits) - 1;

  auto xi = std::bit_cast<uint64_t>(x);
  int raw_exp = (xi >> significand_bits) & exponent_shifted_mask;
  bool signbit = (xi >> (exponent_bits + significand_bits)) != 0;
  uint64_t raw_m = xi & significand_mask;

  if (raw_exp == exponent_shifted_mask) [[unlikely]] {
    // infinity and NaN
    return { raw_m, raw_exp - exponent_offset, signbit };
  }
  if (raw_exp == 0) [[unlikely]] {
    // When the biased exponent is zero,
    // the number is either subnormal or zero.
    // Either way, there is no implicit leading 1 before the significand,
    // so the raw significand can be reinterpreted as an integer.
    return { raw_m, min_exponent, signbit };
  }
  return {
    raw_m | implicit_significand_bit,
    raw_exp - exponent_offset,
    signbit,
  };
}
}

\tt{clang++-24 -O3 -march=x86-64-v3} output
(labels adjusted for readability):

\codeblock("nasm"){
decompose_float:
        mov     edx, 4294966222
        vmovq   rcx, xmm0
        mov     rsi, rcx
        shr     rsi, 52
        and     esi, 2047
        mov     al, 52
        bzhi    rax, rcx, rax
        cmp     esi, 2047
        je      .inf_or_nan
        test    esi, esi
        je      .subnormal_or_zero
        movabs  rdi, 4503599627370496
        or      rax, rdi
        add     esi, -1075
.common_exit:
        shr     rcx, 31
        add     rdx, 1074
        and     rdx, rcx
        or      rdx, rsi
        ret
.inf_or_nan:
        mov     esi, 972
        jmp     .common_exit
.subnormal_or_zero:
        mov     esi, 4294966222
        jmp     .common_exit
}

\h3(
  id="impl-frexp",
  show_number=false,
){\tt{frexp(float64_t, int*)}}

\cppblock{
constexpr float64_t frexp(float64_t x, int *e)
{
  auto xi = std::bit_cast<uint64_t>(x);
  int raw_exp = (xi >> 52) & 0x7ff;

  if (raw_exp == 0x7ff) [[unlikely]] {
    // infinity or NaN
    return x;
  }
  if (raw_exp == 0) [[unlikely]] {
    // subnormals or zero
    if (x) [[unlikely]] {
      // subnormal numbers
      xi = std::bit_cast<uint64_t>(x * 0x1p64);
      raw_exp = ((xi >> 52) & 0x7ff) - 64;
    } else {
      // exactly zero
      *e = 0;
      return x;
    }
  }

  *e = raw_exp - 0x3fe;
  xi &= 0x800fffffffffffffull; // exponent bits = 0
  xi |= 0x3fe0000000000000ull; // exponent bits |= 0x3fe
  return std::bit_cast<double>(xi);
}
}

\tt{clang++-24 -O3 -march=x86-64-v3} output
(labels adjusted for readability):

\codeblock("nasm"){
.x1p64:
        .quad   0x43f0000000000000
frexp:
        vmovq   rax, xmm0
        mov     rcx, rax
        shr     rcx, 52
        and     ecx, 2047
        cmp     ecx, 2047
        je      .inf_or_nan
        test    ecx, ecx
        je      .subnormal_or_zero
.common_exit:
        add     ecx, -1022
        mov     dword ptr [rdi], ecx
        movabs  rcx, -9218868437227405313
        and     rcx, rax
        movabs  rax, 4602678819172646912
        or      rax, rcx
        vmovq   xmm0, rax
.inf_or_nan:
        ret
.subnormal_or_zero:
        vxorpd  xmm1, xmm1, xmm1
        vucomisd xmm0, xmm1
        jne     .subnormal
        jp      .subnormal
        mov     dword ptr [rdi], 0
        ret
.subnormal:
        vmulsd  xmm0, xmm0, qword ptr [rip + .x1p64]
        vmovq   rax, xmm0
        mov     rcx, rax
        shr     rcx, 52
        and     ecx, 2047
        add     ecx, -64
        jmp     .common_exit
}

\h3(
  id="impl-frexpq",
  show_number=false,
){\tt{frexpq(float64_t, int*)}}

\cppblock{
constexpr float64_t frexpq(float64_t x, int *e)
{
  auto xi = std::bit_cast<uint64_t>(x);
  int raw_exp = (xi >> 52) & 0x7ff;

  if (raw_exp == 0x7ff) [[unlikely]] {
    // infinity or NaN
    return x;
  }
  if (raw_exp == 0) [[unlikely]] {
    // subnormals or zero
    if (x) [[unlikely]] {
      // subnormal numbers
      xi = std::bit_cast<uint64_t>(x * 0x1p64);
      raw_exp = ((xi >> 52) & 0x7ff) - 64;
    } else {
      // exactly zero
      *e = 0;
      return x;
    }
  }

  *e = raw_exp - 0x433;
  xi &= 0x800fffffffffffffull; // exponent bits = 0
  xi |= 0x4330000000000000ull; // exponent bits |= 0x433
  return std::bit_cast<double>(xi);
}
}

