\Bins{
\cowel_html_element("h4"){Boolean accessors \stable_ref{float.decompose.boolean}}

\itemdecl{
constexpr bool is_finite() const noexcept;
constexpr bool is_inf() const noexcept;
constexpr bool is_nan() const noexcept;
constexpr bool is_normal() const noexcept;
constexpr bool sign_bit() const noexcept;
\mark{constexpr bool is_signaling() const noexcept;}
\mark{constexpr bool is_subnormal() const noexcept;}
\mark{constexpr bool is_zero() const noexcept;}
}

\itemdescr{
¶
\returns
\tcode{\exposid{test-fun}(\math{\mi{x}})}, where
\tcode{\exposid{test-fun}} is the corresponding function in \header{cmath}
with the underscore in the name removed, and
\math{\mi{x}} is the underlying value.
}
}

\h3(show_number=false){[float.decompose.function]}

Nested under \internal_ref{float.decompose.class},
insert a new subclause:

\Bins{
\cowel_html_element("h3"){Function \tcode{decompose_float} \stable_ref{float.decompose.function}}

\itemdecl{
template<class T>
  constexpr float_decomposition<T> decompose_float(const T& x) noexcept;
}

\itemdescr{
¶
\constraints
\tcode{T} is a cv-unqualified floating-point type.

¶
\returns
A \tcode{float_decomposition<T>} object whose underlying value is \tcode{x}.

¶
\remarks
No floating-point exceptions are raised, and
no inexact operation takes place.
}
}

