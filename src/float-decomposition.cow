\h2(show_number=false){Appendix \'EM DASH' Sample implementations}

\h3(
  id="impl-decompose-float",
  show_number=false,
){\tt{decompose_float(float64_t)}}

\cppblock{\cowel_include_text("float-decomposition.cpp")}

\tt{clang++-24 -O3 -march=x86-64-v3} output
(labels adjusted for readability):

\codeblock("nasm"){
decompose_float:
        vmovq   rcx, xmm0
        mov     rdx, rcx
        shr     rdx, 52
        mov     al, 52
        bzhi    rax, rcx, rax
        and     edx, 2047
        je      .subnormal_or_zero
        cmp     edx, 2047
        je      .skip_adding_integer_bit
        movabs  rsi, 4503599627370496
        or      rax, rsi
.skip_adding_integer_bit:
        add     edx, -1075
        shr     rcx, 31
        movabs  rsi, 4294967296
        and     rsi, rcx
        or      rdx, rsi
        ret
.subnormal_or_zero:
        add     rax, rax
        jmp     .skip_adding_integer_bit
}

\h3(
  id="impl-frexp",
  show_number=false,
){\tt{frexp(float64_t, int*)}}

\cppblock{
constexpr float64_t frexp(float64_t x, int *e)
{
  auto xi = std::bit_cast<uint64_t>(x);
  int raw_exp = (xi >> 52) & 0x7ff;

  if (raw_exp == 0x7ff) [[unlikely]] {
    // infinity or NaN
    return x;
  }
  if (raw_exp == 0) [[unlikely]] {
    // subnormals or zero
    if (x) [[unlikely]] {
      // subnormal numbers
      xi = std::bit_cast<uint64_t>(x * 0x1p64);
      raw_exp = ((xi >> 52) & 0x7ff) - 64;
    } else {
      // exactly zero
      *e = 0;
      return x;
    }
  }

  *e = raw_exp - 0x3fe;
  xi &= 0x800fffffffffffffull; // exponent bits = 0
  xi |= 0x3fe0000000000000ull; // exponent bits |= 0x3fe
  return std::bit_cast<double>(xi);
}
}

\tt{clang++-24 -O3 -march=x86-64-v3} output
(labels adjusted for readability):

\codeblock("nasm"){
.x1p64:
        .quad   0x43f0000000000000
frexp:
        vmovq   rax, xmm0
        mov     rcx, rax
        shr     rcx, 52
        and     ecx, 2047
        cmp     ecx, 2047
        je      .inf_or_nan
        test    ecx, ecx
        je      .subnormal_or_zero
.common_exit:
        add     ecx, -1022
        mov     dword ptr [rdi], ecx
        movabs  rcx, -9218868437227405313
        and     rcx, rax
        movabs  rax, 4602678819172646912
        or      rax, rcx
        vmovq   xmm0, rax
.inf_or_nan:
        ret
.subnormal_or_zero:
        vxorpd  xmm1, xmm1, xmm1
        vucomisd xmm0, xmm1
        jne     .subnormal
        jp      .subnormal
        mov     dword ptr [rdi], 0
        ret
.subnormal:
        vmulsd  xmm0, xmm0, qword ptr [rip + .x1p64]
        vmovq   rax, xmm0
        mov     rcx, rax
        shr     rcx, 52
        and     ecx, 2047
        add     ecx, -64
        jmp     .common_exit
}

\h3(
  id="impl-frexpq",
  show_number=false,
){\tt{frexpq(float64_t, int*)}}

\cppblock{
constexpr float64_t frexpq(float64_t x, int *e)
{
  auto xi = std::bit_cast<uint64_t>(x);
  int raw_exp = (xi >> 52) & 0x7ff;

  if (raw_exp == 0x7ff) [[unlikely]] {
    // infinity or NaN
    return x;
  }
  if (raw_exp == 0) [[unlikely]] {
    // subnormals or zero
    if (x) [[unlikely]] {
      // subnormal numbers
      xi = std::bit_cast<uint64_t>(x * 0x1p64);
      raw_exp = ((xi >> 52) & 0x7ff) - 64;
    } else {
      // exactly zero
      *e = 0;
      return x;
    }
  }

  *e = raw_exp - 0x433;
  xi &= 0x800fffffffffffffull; // exponent bits = 0
  xi |= 0x4330000000000000ull; // exponent bits |= 0x433
  return std::bit_cast<double>(xi);
}
}

