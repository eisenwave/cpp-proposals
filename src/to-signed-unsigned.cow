  \dt{Reply-to:}        \dd{Jan Schultke <\mail{janschultke@gmail.com}>}
  \dt{GitHub Issue:}    \dd{\ref("https://wg21.link/P3643/github")}
  \dt{Source:}          \dd{\ref("https://github.com/eisenwave/cpp-proposals/blob/main/src/to-signed-unsigned.cow")}
}
\hr
}

\Babstract{
Add \tcode{std::to_signed} and \tcode{std::to_unsigned} function templates
in the style of \tcode{std::to_underlying}.
}

\h2(listed=false){Contents}

\make_contents

\h2{Revision history}

\h3{Changes since R2}

\ul{
  \li{updated GitHub code search result count in \ref("#existing-developer-practice")}
  \li{added \ref("#rust-cast_signed-and-cast_unsigned")}
  \li{rebased \ref("#wording") on \ref("N5054")}
}

